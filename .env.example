# متغیرهای محیطی — همه اختیاری هستند و مقادیر پیش‌فرض دارند
# روی Vercel: Project Settings → Environment Variables

# اطلاعات ورود پنل (پیش‌فرض: rayan1234 / 123456)
ADMIN_USERNAME=rayan1234
ADMIN_PASSWORD=123456

# کلید امضای توکن ورود — یک عبارت تصادفی طولانی بگذارید
# اگر خالی بماند، به‌صورت خودکار ساخته و ذخیره می‌شود
ADMIN_SECRET=

# توکن Vercel Blob — روی Vercel بعد از ساخت Blob Store به‌صورت خودکار تنظیم می‌شود
# BLOB_READ_WRITE_TOKEN=
